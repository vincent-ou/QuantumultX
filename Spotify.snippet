# Spotify — 规则（配合 SpotifyProto.js、SpotifyJson.js、SpotifyHeader.js 使用）
# 原作者：app2smile
# 适配版本：未注明
# 部分解锁 Premium；音质不能设置为超高；建议登录后再打开脚本，重启 App 等待生效
[rewrite_local]
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/SpotifyHeader.js
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/SpotifyProto.js
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/ url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/SpotifyJson.js

[mitm]
hostname = spclient.wg.spotify.com, *spclient.spotify.com
