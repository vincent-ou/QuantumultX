# KuWoYinYue — 规则（配合 kuwoyinyue.js 使用）
[rewrite_local]
^https?:\/\/.*\.(kuwo|lrts)\.(cn|me)\/(a\.p|music\.pay|(vip\/(v2|enc)\/(theme|user\/vip))|(EcomResource|(Mobile)?Ad)Serv(er|ice)).* url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/89996462/kuwoyinyue.js

[mitm]
hostname = *.kuwo.cn, *.lrts.me
