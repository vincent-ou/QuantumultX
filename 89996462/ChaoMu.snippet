# 朝暮 — 规则（配合 chaomu.js 使用）
[rewrite_local]
^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/89996462/chaomu.js
^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$) url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/89996462/chaomu.js

[mitm]

hostname = api.revenuecat.com
