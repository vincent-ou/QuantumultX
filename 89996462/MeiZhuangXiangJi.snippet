# 美妆相机 — 规则（配合 meizhuangxiangji.js 使用）
[rewrite_local]
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/89996462/meizhuangxiangji.js
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/89996462/meizhuangxiangji.js

[mitm]

hostname = api.revenuecat.com
