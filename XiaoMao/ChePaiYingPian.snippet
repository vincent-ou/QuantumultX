# 车牌影片搜索 — 规则（配合 chepaiyingpian.js 使用）

[rewrite_local]
^https:\/\/(?:m|www)\.baidu\.com\/s\?.*?[?&](?:word|wd)=(?:av)%23[^&]+ url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/XiaoMao/chepaiyingpian.js
^https?:\/\/(?:[a-zA-Z0-9-]+\.)?google\.[a-zA-Z.]+\/search\?[^&]*q=(av)%23([^&]+) url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/XiaoMao/chepaiyingpian.js

[mitm]
hostname = m.baidu.com,www.baidu.com,www.google.*
