# MP3转换器 — 规则（配合 mp3zhuanhuanqi.js 使用）
[rewrite_local]
^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/XiaoMao/mp3zhuanhuanqi.js

[mitm]
hostname = api.revenuecat.com, api.rc-backup.com
