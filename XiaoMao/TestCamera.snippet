# TestCamera — 规则（配合 TestCamera.js 使用）
[rewrite_local]
^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/XiaoMao/TestCamera.js

[mitm]
hostname = api.revenuecat.com, api.rc-backup.com
