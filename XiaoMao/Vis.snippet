# Vis — 规则（配合 Vis.js 使用）

[rewrite_local]
https:\/\/rc\.visionarytech\.ltd\/v1\/(subscribers|receipts) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/XiaoMao/Vis.js
https:\/\/rc\.visionarytech\.ltd\/v1\/(subscribers|receipts) url script-response-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/XiaoMao/Vis.js

[mitm]
hostname = rc.visionarytech.ltd
