# 拍照识物 — 规则（配合 paizhaoshiwu.js 使用）
[rewrite_local]
# > 拍照识物 vip
# > 开屏广告
^https://ad\.rhinox\.cn/client/sdk/getData url reject
^https?://ad\.rhinox\.cn/.* url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/paizhaoshiwu.js
[mitm]
hostname = ad.rhinox.cn,standard.rhinoxlab.com
