# 快影 — 规则（配合 kuaiying.js 使用）
[rewrite_local]
^https?:\/\/(id\.kwaiying|api\.kmovie\.gifshow)\.com.*$ url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/kuaiying.js
^https://api\.kmovie\.gifshow\.com/rest/n/kmovie/app/merchant/ad/bidding url reject
^https://mi\.gdt\.qq\.com/gdt_mview\.fcg url reject

[mitm]
hostname = api.kmovie.gifshow.com,id.kwaiying.com,mi.gdt.qq.com
