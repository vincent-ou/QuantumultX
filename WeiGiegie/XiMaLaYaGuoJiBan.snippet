^https?:\/\/.+himalaya\.com\/(himalaya-portal\/(track\/urlEncode|v1\/course)|courses\/\d+) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/ximalayaguojiban.js

