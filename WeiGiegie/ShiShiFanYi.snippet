# 实时翻译 — 规则（配合 shishifanyi.js 使用）
[rewrite_local]
^https?:\/\/(translator|accounts).felo.me\/api\/user.*$ url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/shishifanyi.js
^https?:\/\/translator.felo.me\/api\/translation\/thirdToken\?token_channel url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/shishifanyi.js

