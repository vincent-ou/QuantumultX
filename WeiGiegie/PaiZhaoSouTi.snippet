# 拍照搜题 — 规则（配合 paizhaosouti.js 使用）
[rewrite_local]
# > 拍照搜题 vip
# > 开屏广告
^https://ad\.rhinox\.cn/client/sdk/getData url reject
^https?://ad\.rhinox\.cn/.* url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/paizhaosouti.js
[mitm]
hostname = ad.rhinox.cn,appss.rhinoxlab.com
