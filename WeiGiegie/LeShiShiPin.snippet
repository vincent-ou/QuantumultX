# 乐视视频 — 规则（配合 leshishipin.js 使用）
[rewrite_local]
^http:\/\/.+app.m.le.com\/android\/dynamic.php\?mod\=passport url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/leshishipin.js
^http:\/\/.+app.m.le.com\/play\?AD_IPDX url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/leshishipin.js

[mitm]
hostname = app.m.le.com
