# 微信读书 — 规则（配合 weixindushu.js 使用）
[rewrite_local]
# > 微信读书vip(需重新用微信登陆，无法刷新->关闭脚本进入)
^https://i\.weread\.qq\.com/updateConfig url reject
^https?://i\.weread\.qq\.com/.* url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/weixindushu.js
[mitm]
hostname = i.weread.qq.com
