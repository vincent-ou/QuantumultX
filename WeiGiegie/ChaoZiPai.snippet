^https?:\/\/.+meitu.com\/(v2\/user\/vip_info_by_group|filter\/timeline|v2\/user\/info_by_entrance).json url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/chaozipai.js

