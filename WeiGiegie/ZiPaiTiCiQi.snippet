# 自拍题词器 — 规则（配合 zipaiticiqi.js 使用）
[rewrite_local]
# > 自拍题词器 vip
# > 开屏广告
^https://ad\.rhinox\.cn/client/sdk/getData url reject
^https?://ad\.rhinox\.cn/.* url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/main/WeiGiegie/zipaiticiqi.js
[mitm]
hostname = ad.rhinox.cn,standard.rhinoxlab.com.appss.rhinoxlab.com,appss.rhinox.cn
