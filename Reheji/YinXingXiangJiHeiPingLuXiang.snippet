# 隐形相机黑屏录像 — 规则（配合 yinxingxiangjiheipingluxiang.js 使用）
[rewrite_local]
^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/Reheji/yinxingxiangjiheipingluxiang.js

[mitm]
hostname = api.revenuecat.com, api.rc-backup.com
