# ReadCopilot — 规则（配合 ReadCopilot.js 使用）
[rewrite_local]
^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/Reheji/ReadCopilot.js

[mitm]
hostname = api.revenuecat.com, api.rc-backup.com
