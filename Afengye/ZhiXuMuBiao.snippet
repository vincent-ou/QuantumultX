# 秩序目标 — 规则（配合 zhixumubiao.js 使用）
[rewrite_local]
^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/.+$) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/Afengye/zhixumubiao.js
^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/.+$) url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/Afengye/zhixumubiao.js
[mitm]
hostname = api.revenuecat.com, api.rc-backup.com
