# LinearityCurve — 规则（配合 LinearityCurve.js 使用）
[rewrite_local]
^https?:\/\/.*\.linearity\.io\/.+\/(receipts$|subscribers\/?(.*?)*$) url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/Collections/LinearityCurve.js
^https?:\/\/.*\.linearity\.io\/.+\/(receipts$|subscribers\/?(.*?)*$) url script-request-header https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/Collections/LinearityCurve.js

[mitm]
hostname = *.linearity.io
