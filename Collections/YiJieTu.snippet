# 易截图 — 规则（配合 yijietu.js 使用）
[rewrite_local]
https://jietu6.com/apiv2/version url reject
^http[s]?:\/\/.*(1jietu|jietu6)\.com\/.* url script-response-body https://raw.githubusercontent.com/vincent-ou/QuantumultX/refs/heads/main/Collections/yijietu.js

[mitm]
hostname = 1jietu.com, *.1jietu.com, jietu6.com, *.jietu6.com
